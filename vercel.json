{
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/image(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/backups/auto-mensual",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/alertas/rondas-diario?shift=noche",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/alertas/rondas-diario?shift=dia",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/pmi/cumplimiento/alerta",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/informe-semanal",
      "schedule": "0 11 * * 2"
    }
  ]
}
