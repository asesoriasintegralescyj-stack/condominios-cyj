# ===========================================
# VARIABLES DE ENTORNO - SISTEMA CYJ CONDOMINIOS
# ===========================================
# Copia este archivo como .env.local para desarrollo local
# O configura estas variables en Vercel para producción

# -------------------------------------------
# BASE DE DATOS (PostgreSQL en Vercel)
# -------------------------------------------
# Para Vercel Postgres, se obtiene automáticamente al crear la base de datos
# Formato: postgres://usuario:password@host:5432/database?sslmode=require
DATABASE_URL="postgres://default:xxxxx@host.pg.vercel-storage.com:5432/verceldb?sslmode=require"

# Para desarrollo local con SQLite:
# DATABASE_URL="file:./dev.db"

# -------------------------------------------
# NEXTAUTH (Autenticación)
# -------------------------------------------
# URL de tu aplicación (cambiar en producción)
NEXTAUTH_URL="http://localhost:3000"
# En producción: https://tu-dominio.vercel.app

# Secreto para JWT (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui-generar-con-openssl"

# -------------------------------------------
# OPCIONAL: APIs Externas
# -------------------------------------------
# OpenAI API (para funcionalidades de IA)
# OPENAI_API_KEY="sk-xxxxx"

# Email SMTP (para notificaciones)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASSWORD="tu-app-password"
