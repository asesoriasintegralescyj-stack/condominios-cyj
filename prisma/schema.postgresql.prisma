// Schema para PRODUCCIÓN (PostgreSQL - Vercel/Neon)
// Para usar en producción, cambiar el provider de sqlite a postgresql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// CONDOMINIOS (MULTI-CONDOMINIO)
// ============================================
model Condominio {
  id            String   @id @default(cuid())
  nombre        String
  direccion     String?
  comuna        String?
  ciudad        String?
  rut           String?
  telefono      String?
  email         String?
  logo          String?
  etapas        String?
  estado        String   @default("Activo")
  fechaInicio   String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  propiedades   Propiedad[]
  residentes    Residente[]
  personal      Personal[]
  activos       Activo[]
  ordenesTrabajo OrdenTrabajo[]
  proyectos     Proyecto[]
  inspecciones  Inspeccion[]
  gastos        Gasto[]
  proveedores   Proveedor[]
  reservas      Reserva[]
  gastosComunes GastoComun[]
  notificaciones Notificacion[]
  catMateriales CatMaterial[]
  catHerramientas CatHerramienta[]
  catTareas     CatTarea[]
  centroCostos  CentroCostoMaster[]
  puntosRonda   PuntoRonda[]
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String
  apellido      String?
  password      String
  rut           String?  @unique
  telefono      String?
  direccion     String?
  rol           String   @default("usuario")
  permisos      String?
  activo        Boolean  @default(true)
  emailVerificado DateTime?
  ultimoAcceso  DateTime?
  intentosLogin Int      @default(0)
  bloqueadoHasta DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  resetToken    String?
  resetTokenExp DateTime?
  creadoPor     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  cuentas       Cuenta[]
  logsAuditoria LogAuditoria[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Cuenta {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  
  @@unique([provider, providerId])
}

model LogAuditoria {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accion      String
  entidad     String
  entidadId   String?
  datosAntes  String?
  datosDespues String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

// ============================================
// PROPIEDADES / UNIDADES
// ============================================
model Propiedad {
  id           String   @id @default(cuid())
  nombre       String
  tipo         String   @default("Casa")
  estado       String   @default("Disponible")
  direccion    String?
  habitaciones Int      @default(0)
  banos        Int      @default(0)
  mts2         Float    @default(0)
  precio       Float    @default(0)
  contacto     String?
  telefono     String?
  email        String?
  fotos        String?
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  condominioId String?
  condominio   Condominio? @relation(fields: [condominioId], references: [id])

  residentes   Residente[]
  otPropiedad  OrdenTrabajo[] @relation("OTPropiedad")
}

// ============================================
// RESIDENTES
// ============================================
model Residente {
  id            String   @id @default(cuid())
  nombre        String
  apellido      String?
  rut           String?
  unidad        String?
  etapa         String?
  tipo          String   @default("Residente")
  telefono      String?
  email         String?
  fechaIngreso  String?
  estado        String   @default("Activo")
  vehiculos     String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])

  propiedadId   String?
  propiedad     Propiedad? @relation(fields: [propiedadId], references: [id])
  
  reservas      Reserva[]
  pagosGastos   PagoGastoComun[]
}

// ============================================
// PERSONAL / EMPLEADOS
// ============================================
model Personal {
  id            String   @id @default(cuid())
  nombre        String
  rut           String?
  cargo         String?
  contrato      String   @default("Indefinido")
  afp           String   @default("ProVida")
  salud         String   @default("Fonasa")
  mutual        String   @default("IST")
  ccaf          String?
  fechaIngreso  String?
  sueldoBase    Float    @default(0)
  movilizacion  Float    @default(0)
  colacion      Float    @default(0)
  viatico       Float    @default(0)
  asigFamiliar  Float    @default(0)
  estado        String   @default("Activo")
  email         String?
  telefono      String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])

  activos       Activo[] @relation("ActivoAsignado")
  otPersonal    OrdenTrabajo[] @relation("OTPersonal")
  asistencias   Asistencia[]
}

// ============================================
// ACTIVOS / INVENTARIO
// ============================================
model Activo {
  id            String   @id @default(cuid())
  nombre        String
  categoria     String   @default("Equipo")
  estado        String   @default("Activo")
  ubicacion     String?
  serie         String?
  fechaCompra   String?
  costoCompra   Float    @default(0)
  valorActual   Float    @default(0)
  descripcion   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])

  asignadoId    String?
  asignado      Personal? @relation("ActivoAsignado", fields: [asignadoId], references: [id])
  otActivo      OrdenTrabajo[] @relation("OTActivo")
}

// ============================================
// PROVEEDORES
// ============================================
model Proveedor {
  id             String   @id @default(cuid())
  razonSocial    String
  rut            String?
  giro           String?
  direccion      String?
  comuna         String?
  telCorp        String?
  emailCorp      String?
  web            String?
  contacto       String?
  cargo          String?
  telDirecto     String?
  emailContacto  String?
  celular        String?
  estado         String   @default("Activo")
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  condominioId   String?
  condominio     Condominio? @relation(fields: [condominioId], references: [id])

  gastos         Gasto[]
}

// ============================================
// CENTROS DE COSTO
// ============================================
model CentroCostoMaster {
  id              String   @id @default(cuid())
  codigo          String   @unique
  nombre          String
  descripcion     String?
  responsable     String?
  tipoGasto       String   @default("Variable")
  presupuestoMens Float    @default(0)
  presupuestoAnual Float   @default(0)
  estado          String   @default("Activo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])

  tareas          CatTarea[]
  materiales      CatMaterial[]
  herramientas    CatHerramienta[]
  ordenesTrabajo  OrdenTrabajo[]
  gastos          Gasto[]
}

// ============================================
// ÓRDENES DE TRABAJO
// ============================================
model OrdenTrabajo {
  id              String   @id @default(cuid())
  otNum           String   @unique
  titulo          String
  tipo            String   @default("Correctivo")
  prioridad       String   @default("Media")
  estado          String   @default("Pendiente")
  ubicacion       String?
  fechaInicio     String?
  fechaLimite     String?
  fechaInicioReal String?
  fechaFinReal    String?
  costoEstimado   Float    @default(0)
  costoReal       Float    @default(0)
  progreso        Int      @default(0)
  descripcion     String?
  tempoEst        Int      @default(0)
  tiempoReal      Int      @default(0)
  valorHora       Float    @default(0)
  notas           String?
  esRecurrente    Boolean  @default(false)
  tareaOrigenId   String?
  proximaEjecucion String?
  formaPago       String?
  estadoAprobacion  String?  @default("Pendiente")
  fechaSolicitudAprob String?
  fechaAprobacion   String?
  aprobadoPor       String?
  observacionesAprob String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])

  propiedadId     String?
  propiedad       Propiedad? @relation("OTPropiedad", fields: [propiedadId], references: [id])
  asignadoId      String?
  asignado        Personal? @relation("OTPersonal", fields: [asignadoId], references: [id])
  activoId        String?
  activo          Activo? @relation("OTActivo", fields: [activoId], references: [id])
  
  centroCostoId   String?
  centroCosto     CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])

  materiales      OTMaterial[]
  herramientas    OTHerramienta[]
  tareas          OTTarea[]
  personalOT      OTPersonal[]
  documentos      OTDocumento[]
  historialAprobaciones HistorialAprobacionOT[]
}

model OTMaterial {
  id            String   @id @default(cuid())
  descripcion   String
  cantidad      Float    @default(1)
  precioUnit    Float    @default(0)
  total         Float    @default(0)
  unidad        String   @default("unidad")
  otId          String
  ot            OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTHerramienta {
  id        String   @id @default(cuid())
  nombre    String
  cantidad  Int      @default(1)
  otId      String
  ot        OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTTarea {
  id          String   @id @default(cuid())
  descripcion String
  cantidad    Int      @default(1)
  estado      String   @default("Pendiente")
  otId        String
  ot          OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTPersonal {
  id              String   @id @default(cuid())
  nombre          String
  tipo            String   @default("Interno")
  cantidad        Int      @default(1)
  precioUnit      Float    @default(0)
  horasTrabajadas Float    @default(0)
  total           Float    @default(0)
  cumple          Boolean?
  observaciones   String?
  otId            String
  ot              OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTDocumento {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String   @default("documento")
  archivo   String
  otId      String
  ot        OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

// ============================================
// PROYECTOS
// ============================================
model Proyecto {
  id            String   @id @default(cuid())
  nombre        String
  categoria     String   @default("General")
  estado        String   @default("Planificado")
  ubicacion     String?
  fechaInicio   String?
  fechaFin      String?
  presProg      Float    @default(0)
  presUsado     Float    @default(0)
  avance        Int      @default(0)
  descripcion   String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])

  materiales    ProyectoMaterial[]
  herramientas  ProyectoHerramienta[]
  tareas        ProyectoTarea[]
  personal      ProyectoPersonal[]
}

model ProyectoMaterial {
  id          String   @id @default(cuid())
  descripcion String
  cantidad    Float    @default(1)
  precioUnit  Float    @default(0)
  total       Float    @default(0)
  unidad      String   @default("unidad")
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoHerramienta {
  id          String   @id @default(cuid())
  nombre      String
  cantidad    Int      @default(1)
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoTarea {
  id          String   @id @default(cuid())
  descripcion String
  cantidad    Int      @default(1)
  estado      String   @default("Pendiente")
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoPersonal {
  id          String   @id @default(cuid())
  nombre      String
  tipo        String   @default("Interno")
  cantidad    Int      @default(1)
  precioUnit  Float    @default(0)
  total       Float    @default(0)
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

// ============================================
// INSPECCIONES
// ============================================
model Inspeccion {
  id            String   @id @default(cuid())
  titulo        String
  tipo          String   @default("Mantenimiento")
  estado        String   @default("Planificado")
  fecha         String?
  hora          String?
  ubicacion     String?
  asignado      String?
  descripcion   String?
  recurrente    Boolean  @default(false)
  notas         String?
  fotosAntes    String?
  fotosDurante  String?
  fotosDespues  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
}

// ============================================
// GASTOS / RENDICIÓN
// ============================================
model Gasto {
  id            String   @id @default(cuid())
  descripcion   String
  categoria     String   @default("Mantenimiento")
  estado        String   @default("Pendiente")
  monto         Float    @default(0)
  fecha         String?
  propiedad     String?
  proveedorId   String?
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])
  nDoc          String?
  notas         String?
  comprobante   String?
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
  centroCostoId String?
  centroCosto   CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// CAJA CHICA
// ============================================
model CajaChica {
  id            String   @id @default(cuid())
  saldo         Float    @default(0)
  saldoInicial  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// CATÁLOGOS MEJORADOS
// ============================================
model CatMaterial {
  id            String   @id @default(cuid())
  codigo        String?  @unique
  nombre        String
  unidad        String   @default("unidad")
  precioUnit    Float    @default(0)
  categoria     String   @default("General")
  stockMinimo   Int      @default(0)
  stockActual   Int      @default(0)
  ubicacion     String?
  descripcion   String?
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
  centroCostoId String?
  centroCosto   CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CatHerramienta {
  id              String   @id @default(cuid())
  codigo          String?  @unique
  nombre          String
  marca           String?
  modelo          String?
  cantidad        Int      @default(1)
  ubicacion       String?
  estado          String   @default("Bueno")
  valorReposicion Float    @default(0)
  fechaAdquisicion String?
  descripcion     String?
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])
  centroCostoId   String?
  centroCosto     CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CatTarea {
  id              String   @id @default(cuid())
  codigo          String?  @unique
  nombre          String
  categoria       String   @default("General")
  sistema         String?
  tipoMantencion  String   @default("Preventivo")
  frecuencia      String?
  responsable     String?
  tiempoEstimado  Int      @default(0)
  descripcion     String?
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])
  centroCostoId   String?
  centroCosto     CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  esRecurrente    Boolean  @default(false)
  activa          Boolean  @default(true)
  proximaEjecucion String?
  ultimaEjecucion String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// RESERVAS
// ============================================
model Reserva {
  id            String   @id @default(cuid())
  titulo        String
  espacio       String
  fecha         String
  horaInicio    String
  horaFin       String
  residente     String
  unidad        String?
  telefono      String?
  email         String?
  numPersonas   Int      @default(1)
  estado        String   @default("Pendiente")
  monto         Float    @default(0)
  pagado        Boolean  @default(false)
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
  residenteId   String?
  residenteRel  Residente? @relation(fields: [residenteId], references: [id])
}

// ============================================
// CONFIGURACIÓN DEL SISTEMA
// ============================================
model Configuracion {
  id            String   @id @default(cuid())
  clave         String   @unique
  valor         String
  descripcion   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// GASTOS COMUNES
// ============================================
model GastoComun {
  id              String   @id @default(cuid())
  periodo         String
  fechaEmision    String
  fechaVencimiento String
  estado          String   @default("Pendiente")
  totalGastos     Float    @default(0)
  totalCobrar     Float    @default(0)
  montoPorUnidad  Float    @default(0)
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])
  detalles        DetalleGastoComun[]
  pagos           PagoGastoComun[]
}

model DetalleGastoComun {
  id            String   @id @default(cuid())
  concepto      String
  categoria     String   @default("General")
  monto         Float    @default(0)
  centroCosto   String?
  notas         String?
  gastoComunId  String
  gastoComun    GastoComun @relation(fields: [gastoComunId], references: [id], onDelete: Cascade)
}

model PagoGastoComun {
  id            String   @id @default(cuid())
  monto         Float    @default(0)
  fechaPago     String
  metodo        String   @default("Efectivo")
  referencia    String?
  estado        String   @default("Pagado")
  notas         String?
  residenteId   String?
  residente     Residente? @relation(fields: [residenteId], references: [id])
  gastoComunId  String
  gastoComun    GastoComun @relation(fields: [gastoComunId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// NOTIFICACIONES
// ============================================
model Notificacion {
  id            String   @id @default(cuid())
  titulo        String
  mensaje       String
  tipo          String   @default("Info")
  categoria     String   @default("General")
  destino       String   @default("Todos")
  destinoId     String?
  leido         Boolean  @default(false)
  fechaEnvio    String?
  fechaLeido    String?
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// ASISTENCIA
// ============================================
model Asistencia {
  id            String   @id @default(cuid())
  personalId    String
  personal      Personal  @relation(fields: [personalId], references: [id])
  fecha         String
  horaEntrada   String?
  horaSalida    String?
  estado        String    @default("Pendiente")
  observaciones String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([personalId, fecha])
}

// ============================================
// CONTABILIDAD
// ============================================
model CuentaContable {
  id            String   @id @default(cuid())
  codigo        String   @unique
  nombre        String
  tipo          String   @default("Cuenta")
  nivel         Int      @default(1)
  padreId       String?
  padre         CuentaContable? @relation("CuentaJerarquia", fields: [padreId], references: [id])
  hijos         CuentaContable[] @relation("CuentaJerarquia")
  saldo         Float    @default(0)
  estado        String   @default("Activa")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  detalles      DetalleAsiento[]
}

model AsientoContable {
  id            String   @id @default(cuid())
  numero        String   @unique
  fecha         String
  glosa         String
  tipo          String   @default("Normal")
  estado        String   @default("Pendiente")
  totalDebe     Float    @default(0)
  totalHaber    Float    @default(0)
  documento     String?
  documentoId   String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  detalles      DetalleAsiento[]
}

model DetalleAsiento {
  id              String   @id @default(cuid())
  glosa           String?
  debe            Float    @default(0)
  haber           Float    @default(0)
  cuentaId        String
  cuenta          CuentaContable @relation(fields: [cuentaId], references: [cuenta])
  asientoId       String
  asiento         AsientoContable @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// ============================================
// HISTORIAL DE APROBACIONES OT
// ============================================
model HistorialAprobacionOT {
  id              String   @id @default(cuid())
  otId            String
  ordenTrabajo    OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
  estadoAnterior  String?
  estadoNuevo     String
  observaciones   String?
  aprobadoPor     String?
  nombreAprobador String?
  fechaAccion     String
  createdAt       DateTime @default(now())
}

// ============================================
// CUMPLIMIENTO LEGAL (LEY 21.442)
// ============================================
model Cumplimiento {
  id                String   @id @default(cuid())
  titulo            String
  categoria         String   @default("Legal")
  subcategoria      String?
  descripcion       String?
  obligatorio       Boolean  @default(true)
  fechaVencimiento  String?
  fechaRecordatorio String?
  estado            String   @default("Pendiente")
  documentoUrl      String?
  documentoNombre   String?
  notas             String?
  cumplimientoPorc  Int      @default(0)
  condominioId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  historial         HistorialCumplimiento[]
}

model HistorialCumplimiento {
  id              String   @id @default(cuid())
  cumplimientoId  String
  cumplimiento    Cumplimiento @relation(fields: [cumplimientoId], references: [id], onDelete: Cascade)
  accion          String
  descripcion     String
  usuarioId       String?
  usuarioNombre   String?
  fecha           String
  createdAt       DateTime @default(now())
}

// ============================================
// AUDITORÍA
// ============================================
model Auditoria {
  id                String   @id @default(cuid())
  codigo            String   @unique
  titulo            String
  tipo              String   @default("Interna")
  categoria         String   @default("General")
  estado            String   @default("Planificada")
  fechaInicio       String?
  fechaFin          String?
  fechaInforme      String?
  alcance           String?
  objetivo          String?
  responsable       String?
  equipoAuditor     String?
  conclusiones      String?
  recomendaciones   String?
  documentoInforme  String?
  documentoNombre   String?
  notas             String?
  puntuacionTotal   Int      @default(0)
  itemsCriticos     Int      @default(0)
  itemsMayores      Int      @default(0)
  itemsMenores      Int      @default(0)
  condominioId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  items             AuditoriaItem[]
  hallazgos         AuditoriaHallazgo[]
  acciones          AuditoriaAccion[]
}

model AuditoriaItem {
  id                String   @id @default(cuid())
  auditoriaId       String
  auditoria         Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  seccion           String
  pregunta          String
  descricao         String?
  obligatorio       Boolean  @default(true)
  orden             Int      @default(0)
  cumple            Boolean?
  evidencia         String?
  observaciones     String?
  calificacion      String?  @default("N/A")
  criticidad        String?  @default("Menor")
  documentoUrl      String?
  documentoNombre   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AuditoriaHallazgo {
  id                String   @id @default(cuid())
  auditoriaId       String
  auditoria         Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  codigo            String
  titulo            String
  descricao         String
  tipo              String   @default("Observación")
  criticidad        String   @default("Menor")
  area              String?
  proceso           String?
  causaRaiz         String?
  impacto           String?
  estado            String   @default("Abierto")
  fechaDeteccion    String
  fechaLimite       String?
  evidencia         String?
  documentoUrl      String?
  documentoNombre   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  acciones          AuditoriaAccion[]
}

model AuditoriaAccion {
  id                String   @id @default(cuid())
  auditoriaId       String?
  auditoria         Auditoria? @relation(fields: [auditoriaId], references: [id], onDelete: SetNull)
  hallazgoId        String?
  hallazgo          AuditoriaHallazgo? @relation(fields: [hallazgoId], references: [id], onDelete: SetNull)
  codigo            String
  titulo            String
  descricao         String
  tipo              String   @default("Correctiva")
  responsable       String?
  fechaCompromiso   String?
  fechaImplementacion String?
  estado            String   @default("Pendiente")
  verificadoPor     String?
  fechaVerificacion String?
  resultadoVerificacion String?
  evidencia         String?
  documentoUrl      String?
  documentoNombre   String?
  notas             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// RONDAS Y CONTROL DE ACCESO
// ============================================
model PuntoRonda {
  id            String   @id @default(cuid())
  nombre        String
  ubicacion     String
  descripcion   String?
  codigoQr      String   @unique
  activo        Boolean  @default(true)
  orden         Int      @default(0)
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  registros     RegistroRonda[]
}

model RegistroRonda {
  id            String   @id @default(cuid())
  puntoId       String
  punto         PuntoRonda @relation(fields: [puntoId], references: [id])
  usuarioId     String?
  usuarioNombre String?
  fechaHora     DateTime @default(now())
  ubicacion     String?
  observaciones String?
  foto          String?
  estado        String   @default("Normal")
  notaIncidencia String?
  createdAt     DateTime @default(now())

  @@index([puntoId, fechaHora])
  @@index([usuarioId])
}
