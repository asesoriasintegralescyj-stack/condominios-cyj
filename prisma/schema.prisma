// Prisma schema - Sistema CYJ Condominios
// Provider: PostgreSQL (Neon)
// Este es el esquema unico y oficial para desarrollo y produccion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================
// CONDOMINIOS (MULTI-CONDOMINIO)
// ============================================
model Condominio {
  id            String   @id @default(cuid())
  nombre        String
  direccion     String?
  comuna        String?
  ciudad        String?
  rut           String?
  telefono      String?
  email         String?
  logo          String?  // URL o base64 del logo
  etapas        String?  // JSON array de etapas: ["BANDURRIAS", "BECACINAS", etc.]
  estado        String   @default("Activo") // Activo, Inactivo
  fechaInicio   String?  // Fecha inicio del contrato
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  propiedades   Propiedad[]
  personal      Personal[]
  activos       Activo[]
  ordenesTrabajo OrdenTrabajo[]
  proyectos     Proyecto[]
  inspecciones  Inspeccion[]
  proveedores   Proveedor[]
  notificaciones Notificacion[]
  catMateriales CatMaterial[]
  catHerramientas CatHerramienta[]
  catTareas     CatTarea[]
  centroCostos  CentroCostoMaster[]
  // Nuevas relaciones
  comites       Comite[]
  movimientosInventario MovimientoInventario[]
  // Cumplimiento Legal
  categoriasCumplimiento CategoriaCumplimiento[]
  documentosCumplimiento DocumentoCumplimiento[]
  resumenCumplimiento ResumenCumplimiento?
  // Rondas
  rondas         Ronda[]
  // Solicitudes de Compra
  solicitudesCompra SolicitudCompra[]
  listasDesplegables ListaDesplegable[]
  // Rendiciones de Gastos
  rendicionesGastos RendicionGasto[]
  categoriasGastos  CategoriaGasto[] @relation("CategoriasCondominio")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String
  apellido      String?
  password      String   // Hash de la contraseña (bcrypt)
  rut           String?  @unique
  
  // Información de contacto encriptada
  telefono      String?  // Encriptado
  direccion     String?  // Encriptado
  
  // Rol y permisos
  rol           String   @default("usuario") // admin, supervisor, usuario
  permisos      String?  // JSON con permisos específicos
  
  // Estado
  activo        Boolean  @default(true)
  emailVerificado DateTime?
  ultimoAcceso  DateTime?
  
  // Seguridad
  intentosLogin Int      @default(0)
  bloqueadoHasta DateTime?
  twoFactorSecret String? // Para 2FA en el futuro
  twoFactorEnabled Boolean @default(false)
  
  // Tokens
  resetToken    String?
  resetTokenExp DateTime?
  
  // Forzar cambio de contraseña en el próximo inicio de sesión
  cambiarPasswordProximoLogin Boolean @default(false)
  // Contraseña temporal encriptada (para mostrar al admin que la creó)
  passwordTemp String?
  // Fecha del último cambio de contraseña
  lastPasswordChange DateTime?
  // Motivo del último cambio/creación de contraseña (creacion, recuperacion, cambio_forzado, cambio_voluntario)
  lastPasswordChangeMotivo String?
  
  // Auditoría
  creadoPor     String?  // ID del usuario que creó este usuario
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relaciones
  sessions      Session[]
  logsAuditoria LogAuditoria[]
  rendicionesGastos RendicionGasto[]
}

// ============================================
// SESIONES DE USUARIO
// ============================================
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([userId, expiresAt])
}

// ============================================
// CUENTAS EXTERNAS (OAuth)

// ============================================
// LOGS DE AUDITORÍA
// ============================================
model LogAuditoria {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accion      String   // login, logout, create, update, delete
  entidad     String   // Nombre del modelo afectado
  entidadId   String?  // ID del registro afectado
  datosAntes  String?  // JSON con datos antes del cambio
  datosDespues String? // JSON con datos después del cambio
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([entidad])
  @@index([createdAt])
}

// ============================================
// PROPIEDADES / UNIDADES
// ============================================
model Propiedad {
  id           String   @id @default(cuid())
  nombre       String
  tipo         String   @default("Casa") // Casa, Departamento, Local Comercial, Bodega, Estacionamiento
  estado       String   @default("Disponible") // Disponible, Ocupado, Arriendo, Venta, Mantenimiento, Reservado
  direccion    String?
  habitaciones Int      @default(0)
  banos        Int      @default(0)
  mts2         Float    @default(0)
  precio       Float    @default(0)
  contacto     String?
  telefono     String?
  email        String?
  fotos        String?  // JSON array of base64 or URLs
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relación con Condominio
  condominioId String?
  condominio   Condominio? @relation(fields: [condominioId], references: [id])

  otPropiedad  OrdenTrabajo[] @relation("OTPropiedad")
  @@index([condominioId])
  @@index([estado])
}

// ============================================
// RESIDENTES

// ============================================
// PERSONAL / EMPLEADOS
// ============================================
model Personal {
  id            String   @id @default(cuid())
  nombre        String
  rut           String?  @unique
  cargo         String?
  contrato      String   @default("Indefinido") // Indefinido, Plazo Fijo, Por Obra, Part-Time
  afp           String   @default("ProVida")
  salud         String   @default("Fonasa")
  mutual        String   @default("IST")
  ccaf          String?
  fechaIngreso  String?
  sueldoBase    Float    @default(0)
  movilizacion  Float    @default(0)
  colacion      Float    @default(0)
  viatico       Float    @default(0)
  asigFamiliar  Float    @default(0)
  estado        String   @default("Activo") // Activo, Vacaciones, Licencia, Inactivo
  email         String?
  telefono      String?
  foto          String?  // Base64 de la foto del empleado
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relación con Condominio
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])

  activos       Activo[] @relation("ActivoAsignado")
  otPersonal    OrdenTrabajo[] @relation("OTPersonal")
  rendiciones   RendicionGasto[] @relation("RendicionPersonal")
  montosAsignados MontoAsignadoPersonal[]
  asistencias   Asistencia[]
  horariosTrabajador HorarioTrabajador[]
  registrosReloj RegistroAsistenciaReloj[]
  inasistenciasAtrasos InasistenciaAtraso[]
  @@index([condominioId, estado])
  @@index([rut])
  @@index([createdAt])
}

// ============================================
// ACTIVOS / INVENTARIO
// ============================================
model Activo {
  id            String   @id @default(cuid())
  codigo        String?  @unique // ACT-001, ACT-002, etc.
  nombre        String
  categoria     String   @default("Equipo") // Equipo, Herramienta, Vehículo, Mobiliario, Infraestructura, Tecnología
  estado        String   @default("Activo") // Activo, Inactivo, En Reparación, Dado de Baja
  ubicacion     String?
  serie         String?
  fechaCompra   String?
  costoCompra   Float    @default(0)
  valorActual   Float    @default(0)
  descripcion   String?

  // Manual de usuario (PDF)
  manualBase64    String?
  manualNombre    String?
  manualTipo      String?
  // Código QR
  qrCodigo        String?
  // Mantenimiento
  fechaUltimoMantencion     String?
  informeMantencionBase64   String?
  informeMantencionNombre   String?
  informeMantencionTipo     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relación con Condominio
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])

  asignadoId    String?
  asignado      Personal? @relation("ActivoAsignado", fields: [asignadoId], references: [id])
  otActivo      OrdenTrabajo[] @relation("OTActivo")
  @@index([condominioId, estado])
  @@index([categoria])
}

// ============================================
// PROVEEDORES
// ============================================
model Proveedor {
  id             String   @id @default(cuid())
  razonSocial    String
  rut            String?
  giro           String?
  direccion      String?
  comuna         String?
  telCorp        String?
  emailCorp      String?
  web            String?
  contacto       String?
  cargo          String?
  telDirecto     String?
  emailContacto  String?
  celular        String?
  estado         String   @default("Activo") // Activo, Inactivo, En revisión
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relación con Condominio
  condominioId   String?
  condominio     Condominio? @relation(fields: [condominioId], references: [id])

  @@index([estado])
}

// ============================================
// CENTROS DE COSTO (TABLA MAESTRA)
// ============================================
model CentroCostoMaster {
  id              String   @id @default(cuid())
  codigo          String   @unique // CC-ADM-01, CC-SEG-01, etc.
  nombre          String
  descripcion     String?
  responsable     String?
  tipoGasto       String   @default("Variable") // Fijo, Variable, Contrato, Estacional, Fondo de Reserva
  presupuestoMens Float    @default(0)
  presupuestoAnual Float   @default(0)
  estado          String   @default("Activo") // Activo, Inactivo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relación con Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])

  tareas          CatTarea[]
  materiales      CatMaterial[]
  herramientas    CatHerramienta[]
  ordenesTrabajo  OrdenTrabajo[]
  boletasRendicion BoletaRendicion[] @relation("BoletaCentroCosto")
  proyectos       Proyecto[]
  rendicionesGastos RendicionGasto[]
}

// ============================================
// ÓRDENES DE TRABAJO
// ============================================
model OrdenTrabajo {
  id              String   @id @default(cuid())
  otNum           String   @unique
  titulo          String
  tipo            String   @default("Correctivo") // Correctivo, Preventivo, Mejora, Emergencia
  prioridad       String   @default("Media") // Urgente, Alta, Media, Baja
  estado          String   @default("Pendiente") // Pendiente, En Progreso, Completado, Cancelado
  ubicacion       String?
  fechaInicio     String?
  fechaLimite     String?
  fechaInicioReal String?  // Fecha real de inicio
  fechaFinReal    String?  // Fecha real de término
  costoEstimado   Float    @default(0)
  costoReal       Float    @default(0)
  progreso        Int      @default(0)
  descripcion     String?
  tiempoEst       Int      @default(0)  // Tiempo estimado en minutos
  tiempoReal      Int      @default(0)  // Tiempo real en minutos
  valorHora       Float    @default(0)  // Valor hora calculado
  notas           String?
  
  // Campos para tareas recurrentes
  esRecurrente    Boolean  @default(false)
  tareaOrigenId   String?  // ID de la tarea del catálogo que generó esta OT
  proximaEjecucion String? // Fecha de la próxima ejecución programada
  
  // Forma de pago / imputación
  formaPago       String?  // Gasto Común Mensual, Fondo de Reserva, Gasto Extraordinario
  
  // Campos de aprobación
  estadoAprobacion  String?  @default("Pendiente") // Pendiente, Aprobada, Rechazada
  fechaSolicitudAprob String?  // Fecha en que se solicitó aprobación
  fechaAprobacion   String?  // Fecha de aprobación/rechazo
  aprobadoPor       String?  // ID del usuario que aprobó/rechazó
  observacionesAprob String? // Observaciones del supervisor
  creadoPor         String?  // ID del usuario que creó la OT
  
  // Fotos antes y después
  fotosAntes      String?  // JSON array de fotos antes del trabajo
  fotosDespues    String?  // JSON array de fotos después del trabajo
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relación con Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])

  propiedadId     String?
  propiedad       Propiedad? @relation("OTPropiedad", fields: [propiedadId], references: [id])
  asignadoId      String?
  asignado        Personal? @relation("OTPersonal", fields: [asignadoId], references: [id])
  activoId        String?
  activo          Activo? @relation("OTActivo", fields: [activoId], references: [id])
  
  // Relación con Centro de Costo
  centroCostoId   String?
  centroCosto     CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])

  materiales      OTMaterial[]
  herramientas    OTHerramienta[]
  tareas          OTTarea[]
  personalOT      OTPersonal[]
  documentos      OTDocumento[]
  historialAprobaciones HistorialAprobacionOT[]
  @@index([condominioId, estado])
  @@index([estadoAprobacion])
  @@index([asignadoId])
  @@index([propiedadId])
  @@index([centroCostoId])
  @@index([createdAt])
  @@index([fechaInicio])
}

model OTMaterial {
  id            String   @id @default(cuid())
  descripcion   String
  cantidad      Float    @default(1)
  precioUnit    Float    @default(0)
  total         Float    @default(0)
  unidad        String   @default("unidad")
  otId          String
  ot            OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
  // Enlace al inventario (CatMaterial) y mejor precio encontrado
  materialId    String?
  mejorPrecio   Float?
  mejorTienda   String?
  mejorUrl      String?
}

model OTHerramienta {
  id        String   @id @default(cuid())
  nombre    String
  cantidad  Int      @default(1)
  otId      String
  ot        OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTTarea {
  id          String   @id @default(cuid())
  descripcion String
  cantidad    Int      @default(1)
  estado      String   @default("Pendiente") // Pendiente, En Progreso, Completado
  // Checklist de verificación (LV del PMI): OK / NO OK / N/A
  ok          Boolean  @default(false)
  noOk        Boolean  @default(false)
  na          Boolean  @default(false)
  otId        String
  ot          OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTPersonal {
  id              String   @id @default(cuid())
  nombre          String
  tipo            String   @default("Interno") // Interno, Externo
  cantidad        Int      @default(1)
  precioUnit      Float    @default(0)  // Valor hora del personal
  horasTrabajadas Float    @default(0)  // Horas trabajadas
  total           Float    @default(0)  // precioUnit * horasTrabajadas * cantidad
  cumple          Boolean? // Si cumplió la tarea
  observaciones   String?
  otId            String
  ot              OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTDocumento {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String   @default("documento")
  archivo   String   // base64 or URL
  otId      String
  ot        OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

// ============================================
// PROYECTOS
// ============================================
model Proyecto {
  id            String   @id @default(cuid())
  codigo        String?  @unique // PROY-001, PROY-002, etc.
  nombre        String
  categoria     String   @default("General") // Áreas Verdes, Eléctrico, Sanitario, Infraestructura, Seguridad
  estado        String   @default("Planificado") // Planificado, En Ejecución, Completado, Cancelado, Pausado
  ubicacion     String?
  fechaInicio   String?
  fechaFin      String?
  presProg      Float    @default(0) // Presupuesto Programado
  presUsado     Float    @default(0) // Presupuesto Utilizado
  avance        Int      @default(0)
  descripcion   String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Nuevos campos (PMI)
  sector            String?
  tipoReparacion    String?
  tipoTrabajo       String?  // Nuevo: tipo de trabajo (mantención, reparación, instalación, etc.)
  prioridad         String?
  estadoAprobacion  String?
  responsable       String?
  responsableExterno String? // Nuevo: empresa externa responsable (si aplica)
  tiempoEstimado    String?
  monto             Float    @default(0)
  fechaInicioReal   String?
  fechaFinReal      String?
  comentarios       String?
  fotosAntes        String?
  fotosDespues      String?
  cotizaciones      String?

  // Relación con Condominio
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])

  // Relación con Centro de Costo
  centroCostoId     String?
  centroCosto       CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])

  materiales    ProyectoMaterial[]
  herramientas  ProyectoHerramienta[]
  tareas        ProyectoTarea[]
  personal      ProyectoPersonal[]
  documentos    ProyectoDocumento[]
  @@index([condominioId, estado])
  @@index([centroCostoId])
}

model ProyectoMaterial {
  id          String   @id @default(cuid())
  descripcion String
  cantidad    Float    @default(1)
  precioUnit  Float    @default(0)
  total       Float    @default(0)
  unidad      String   @default("unidad")
  linkCompra  String?  // URL de compra del material
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  // Enlace al inventario (CatMaterial) y mejor precio encontrado
  materialId    String?
  mejorPrecio   Float?
  mejorTienda   String?
  mejorUrl      String?
}

model ProyectoHerramienta {
  id          String   @id @default(cuid())
  nombre      String
  cantidad    Int      @default(1)
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoTarea {
  id          String   @id @default(cuid())
  descripcion String
  cantidad    Int      @default(1)
  estado      String   @default("Pendiente")
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoPersonal {
  id          String   @id @default(cuid())
  nombre      String
  tipo        String   @default("Interno")
  cantidad    Int      @default(1)
  precioUnit  Float    @default(0)
  total       Float    @default(0)
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoDocumento {
  id          String   @id @default(cuid())
  nombre      String
  tipo        String   @default("cotizacion") // cotizacion, resaldo, contrato, factura, otro
  descripcion String?
  archivo     String   // base64 or URL
  fechaDoc    String?
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ============================================
// INSPECCIONES
// ============================================
model Inspeccion {
  id            String   @id @default(cuid())
  titulo        String
  tipo          String   @default("Mantenimiento") // Mantenimiento, Seguridad, Eléctrica, Sanitaria, Estructural, General
  estado        String   @default("Planificado") // Planificado, En Progreso, Completado, Cancelado
  fecha         String?
  hora          String?
  ubicacion     String?
  asignado      String?
  descripcion   String?
  recurrente    Boolean  @default(false)
  notas         String?
  fotosAntes    String?  // JSON array
  fotosDurante  String?  // JSON array
  fotosDespues  String?  // JSON array
  fotos         String?  // JSON array of base64 images (general gallery)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relación con Condominio
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
  @@index([condominioId, estado])
}

// ============================================
// CATEGORÍAS DE RENDICIÓN DE GASTOS
// ============================================
model CategoriaGasto {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  color       String   @default("#0f2044") // Color para la UI
  activa      Boolean  @default(true)
  condominioId String?
  condominio   Condominio? @relation("CategoriasCondominio", fields: [condominioId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boletas BoletaRendicion[]

  @@index([activa])
}

// ============================================
// MONTOS ASIGNADOS POR PERSONAL (para rendiciones)
// ============================================
model MontoAsignadoPersonal {
  id          String   @id @default(cuid())
  personalId   String?
  personal    Personal? @relation(fields: [personalId], references: [id], onDelete: SetNull)
  monto       Float    @default(0)       // Monto máximo asignado para rendir
  periodo     String   @default("Mensual") // Mensual, Quincenal, Semanal
  estado      String   @default("Activo") // Activo, Inactivo
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personalId])
}

// ============================================
// RENDICIÓN DE GASTOS (cabecera)
// ============================================
model RendicionGasto {
  id                String   @id @default(cuid())
  codigo            String   @unique // RG-0001, RG-0002, etc.
  periodo           String   // Ej: "2026-07" (YYYY-MM)
  concepto          String  // Ej: "Rendición Julio 2026 - Jefe de Operaciones"
  descripcion       String?
  estado            String   @default("Borrador") // Borrador, En Revisión, Aprobada, Rechazada, Anulada
  montoTotal        Float    @default(0) // Suma de todas las boletas
  montoAsignado     Float    @default(0) // Monto asignado al responsable (para control)
  fechaRendicion    DateTime @default(now())
  fechaAprobacion   DateTime?
  aprobadoPor       String?
  aprobadoPorNombre String?
  observaciones     String?
  motivoRechazo     String?
  
  // Responsable (quien rinde)
  responsableId     String?
  responsable       Personal? @relation("RendicionPersonal", fields: [responsableId], references: [id])
  responsableNombre String? // Denormalizado para queries rápidas
  
  // Email de aprobación
  emailEnviado      Boolean  @default(false)
  emailEnviadoA     String?
  emailFechaEnvio   DateTime?
  
  // Condominio
  condominioId      String?
  condominio        Condominio? @relation(fields: [condominioId], references: [id])

  boletas           BoletaRendicion[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([estado, createdAt])
  @@index([condominioId])
  @@index([responsableId])
  @@index([periodo])
}

// ============================================
// BOLETAS / COMPROBANTES DE RENDICIÓN (detalle)
// Cada boleta tiene su propio centro de costo
// ============================================
model BoletaRendicion {
  id            String   @id @default(cuid())
  rendicionId   String
  rendicion     RendicionGasto @relation(fields: [rendicionId], references: [id], onDelete: Cascade)
  
  descripcion   String  // Descripción del gasto
  monto         Float    @default(0)
  fecha         String?  // Fecha del comprobante
  nDocumento    String?  // Número de documento / boleta
  proveedor     String?  // Nombre del proveedor en el comprobante
  notas         String?
  comprobante   String?  // URL o base64 de la imagen del comprobante
  documento     String?  // URL o base64 del documento adjunto (PDF, Word, etc.)
  
  // Centro de costo va en la BOLETA, no en la rendición
  centroCostoId String?
  centroCosto   CentroCostoMaster? @relation("BoletaCentroCosto", fields: [centroCostoId], references: [id])
  
  // Categoría del gasto
  categoriaId   String?
  categoria     CategoriaGasto? @relation(fields: [categoriaId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([rendicionId])
  @@index([centroCostoId])
  @@index([categoriaId])
}

// ============================================
// CAJA CHICA
// ============================================
model CajaChica {
  id            String   @id @default(cuid())
  saldo         Float    @default(0)
  saldoInicial  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// CATÁLOGOS MEJORADOS (con Centro de Costo)
// ============================================
model CatMaterial {
  id            String   @id @default(cuid())
  codigo        String?  @unique // MAT-ELEC-01, MAT-FONT-01, etc.
  nombre        String
  unidad        String   @default("unidad")
  precioUnit    Float    @default(0)
  categoria     String   @default("General") // Eléctrico, Fontanería, Ferretería, Pintura, Jardinería, Limpieza, Seguridad
  stockMinimo   Int      @default(0)
  stockActual   Int      @default(0)
  ubicacion     String?
  descripcion   String?
  imagenUrl     String?  // URL de la imagen del producto (sfile.chatglm.cn o del proveedor)
  fuente        String?  // Tienda origen: Sodimac, Easy, Imperial, Construplaza
  ultimaActPrecio DateTime? @default(now()) // Última actualización de precio
  
  // Relación con Condominio
  condominioId  String?
  condominio    Condominio? @relation(fields: [condominioId], references: [id])
  
  // Centro de Costo de imputación
  centroCostoId String?
  centroCosto   CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])

  // Cotizaciones de múltiples tiendas para este material
  cotizaciones    CotizacionMercado[] @relation("CotizacionesMaterial")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CatHerramienta {
  id              String   @id @default(cuid())
  codigo          String?  @unique // HERR-01, HERR-02, etc.
  nombre          String
  marca           String?
  modelo          String?
  cantidad        Int      @default(1)
  ubicacion       String?
  estado          String   @default("Bueno") // Bueno, Regular, Malo, En reparación
  valorReposicion Float    @default(0)
  fechaAdquisicion String?
  descripcion     String?
  imagenUrl       String?  // URL de la imagen (sfile.chatglm.cn o del proveedor)
  fuente          String?  // Tienda origen: Sodimac, Easy, Imperial, Construplaza
  ultimaActPrecio DateTime? @default(now()) // Última actualización de valor

  // Manual de usuario (PDF adjunto en base64)
  manualBase64    String?  // PDF en base64
  manualNombre    String?  // Nombre original del archivo
  manualTipo      String?  // Tipo MIME (application/pdf, etc.)

  // Mantenimiento
  fechaUltimoMantencion String? // Fecha del último mantenimiento (yyyy-mm-dd)
  informeMantencionBase64 String? // Informe de mantenimiento en base64 (PDF)
  informeMantencionNombre String? // Nombre del archivo
  informeMantencionTipo   String? // Tipo MIME

  // Código QR (URL para acceder a la info de la herramienta)
  qrCodigo        String?  // URL: https://condominios-cyj.vercel.app/h/{id}

  // Relación con Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])

  // Centro de Costo de adquisición
  centroCostoId   String?
  centroCosto     CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])

  // Relación con salidas de pañol
  salidas         SalidaPanol[]

  // Cotizaciones de múltiples tiendas para esta herramienta
  cotizaciones    CotizacionMercado[] @relation("CotizacionesHerramienta")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// COTIZACIONES DE MERCADO (multi-tienda)
// ============================================
// Para cada material o herramienta se guardan N cotizaciones de distintas
// tiendas (Sodimac, Easy, Imperial, Construplaza, MercadoLibre).
// El sistema devuelve el "mejor precio" (= el más bajo disponible).
model CotizacionMercado {
  id           String   @id @default(cuid())
  // Relación polimórfica: solo uno de los dos tendrá valor
  materialId   String?
  material     CatMaterial? @relation("CotizacionesMaterial", fields: [materialId], references: [id], onDelete: Cascade)
  herramientaId String?
  herramienta  CatHerramienta? @relation("CotizacionesHerramienta", fields: [herramientaId], references: [id], onDelete: Cascade)

  tienda       String   // "Sodimac", "Easy", "Imperial", "Construplaza", "MercadoLibre"
  url          String?  // URL del producto en la tienda
  precio       Float    // Precio en CLP
  disponible   Boolean  @default(true) // false si está agotado
  fechaConsulta DateTime @default(now())

  @@index([materialId])
  @@index([herramientaId])
  @@index([tienda])
}

// ============================================
// SALIDAS DE PAÑOL — Registro de uso de herramientas
// ============================================
model SalidaPanol {
  id              String   @id @default(cuid())
  herramientaId   String
  herramienta     CatHerramienta @relation(fields: [herramientaId], references: [id], onDelete: Cascade)

  // Datos de la salida
  usuarioNombre   String   // Quién retira la herramienta
  usuarioRUT      String?  // RUT del operario (opcional)
  fechaSalida     DateTime @default(now())
  horaSalida      String   // HH:MM
  trabajoRealizar String?  // Descripción del trabajo a realizar
  sectorTrabajo   String?  // Dónde se usará

  // Verificación ANTES de uso (adjunta)
  lvAntesCompletada Boolean @default(false)
  lvAntesItems    String?  // JSON array de items completados
  lvAntesFirma    String?  // Firma en base64 (opcional)

  // Datos de la devolución (ingreso)
  fechaIngreso    DateTime?
  horaIngreso     String?  // HH:MM
  estadoDevolucion String? // Operativo, Regular, Malo, etc.
  comentarios     String?  // Comentarios del operario

  // Verificación DESPUÉS de uso (adjunta)
  lvDespuesCompletada Boolean @default(false)
  lvDespuesItems   String?  // JSON array de items completados
  lvDespuesFirma   String?  // Firma en base64 (opcional)

  estado          String   @default("Pendiente") // Pendiente (salida), Devuelta (ingreso)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([herramientaId, estado])
  @@index([usuarioNombre])
  @@index([fechaSalida])
}

model CatTarea {
  id              String   @id @default(cuid())
  codigo          String?  @unique // MT-ELEC-01, MT-HID-01, etc.
  nombre          String
  categoria       String   @default("General") // Eléctrico, Hidráulico, Ascensores, Gas, Climatización, Seguridad, Infraestructura, Áreas Verdes
  sistema         String?  // Sistema al que pertenece
  tipoMantencion  String   @default("Preventivo") // Preventivo, Correctivo, Predictivo, Legal
  frecuencia      String?  // Diaria, Semanal, Mensual, Trimestral, Semestral, Anual
  responsable     String?  // Responsable sugerido
  tiempoEstimado  Int      @default(0) // Tiempo estimado en minutos
  descripcion     String?
  
  // Relación con Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])
  
  // Centro de Costo asociado
  centroCostoId   String?
  centroCosto     CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  
  // Campos para tareas recurrentes
  esRecurrente    Boolean  @default(false)
  activa          Boolean  @default(true) // Si la tarea está activa para generar OTs
  proximaEjecucion String? // Fecha de la próxima ejecución programada
  ultimaEjecucion String? // Fecha de la última ejecución
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

