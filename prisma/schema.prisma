generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Activo {
  id           String         @id
  nombre       String
  categoria    String         @default("Equipo")
  estado       String         @default("Activo")
  ubicacion    String?
  serie        String?
  fechaCompra  String?
  costoCompra  Float          @default(0)
  valorActual  Float          @default(0)
  descripcion  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  condominioId String?
  asignadoId   String?
  Personal     Personal?      @relation(fields: [asignadoId], references: [id])
  Condominio   Condominio?    @relation(fields: [condominioId], references: [id])
  OrdenTrabajo OrdenTrabajo[]
}

model AsientoContable {
  id             String           @id
  numero         String           @unique
  fecha          String
  glosa          String
  tipo           String           @default("Normal")
  estado         String           @default("Pendiente")
  totalDebe      Float            @default(0)
  totalHaber     Float            @default(0)
  documento      String?
  documentoId    String?
  notas          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  DetalleAsiento DetalleAsiento[]
}

model Asistencia {
  id            String   @id
  personalId    String
  fecha         String
  horaEntrada   String?
  horaSalida    String?
  estado        String   @default("Pendiente")
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Personal      Personal @relation(fields: [personalId], references: [id])

  @@unique([personalId, fecha])
}

model Auditoria {
  id                String              @id
  codigo            String              @unique
  titulo            String
  tipo              String              @default("Interna")
  categoria         String              @default("General")
  estado            String              @default("Planificada")
  fechaInicio       String?
  fechaFin          String?
  fechaInforme      String?
  alcance           String?
  objetivo          String?
  responsable       String?
  equipoAuditor     String?
  conclusiones      String?
  recomendaciones   String?
  documentoInforme  String?
  documentoNombre   String?
  notas             String?
  puntuacionTotal   Int                 @default(0)
  itemsCriticos     Int                 @default(0)
  itemsMayores      Int                 @default(0)
  itemsMenores      Int                 @default(0)
  condominioId      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  AuditoriaAccion   AuditoriaAccion[]
  AuditoriaHallazgo AuditoriaHallazgo[]
  AuditoriaItem     AuditoriaItem[]
}

model AuditoriaAccion {
  id                    String             @id
  auditoriaId           String?
  hallazgoId            String?
  codigo                String
  titulo                String
  descripcion           String
  tipo                  String             @default("Correctiva")
  responsable           String?
  fechaCompromiso       String?
  fechaImplementacion   String?
  estado                String             @default("Pendiente")
  verificadoPor         String?
  fechaVerificacion     String?
  resultadoVerificacion String?
  evidencia             String?
  documentoUrl          String?
  documentoNombre       String?
  notas                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
  AuditoriaHallazgo     AuditoriaHallazgo? @relation(fields: [hallazgoId], references: [id])
  Auditoria             Auditoria?         @relation(fields: [auditoriaId], references: [id])
}

model AuditoriaHallazgo {
  id              String            @id
  auditoriaId     String
  codigo          String
  titulo          String
  descripcion     String
  tipo            String            @default("Observación")
  criticidad      String            @default("Menor")
  area            String?
  proceso         String?
  causaRaiz       String?
  impacto         String?
  estado          String            @default("Abierto")
  fechaDeteccion  String
  fechaLimite     String?
  evidencia       String?
  documentoUrl    String?
  documentoNombre String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  AuditoriaAccion AuditoriaAccion[]
  Auditoria       Auditoria         @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
}

model AuditoriaItem {
  id              String    @id
  auditoriaId     String
  seccion         String
  pregunta        String
  descripcion     String?
  obligatorio     Boolean   @default(true)
  orden           Int       @default(0)
  cumple          Boolean?
  evidencia       String?
  observaciones   String?
  calificacion    String?   @default("N/A")
  criticidad      String?   @default("Menor")
  documentoUrl    String?
  documentoNombre String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Auditoria       Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
}

model CajaChica {
  id           String   @id
  saldo        Float    @default(0)
  saldoInicial Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model CatHerramienta {
  id                String             @id
  codigo            String?            @unique
  nombre            String
  marca             String?
  modelo            String?
  cantidad          Int                @default(1)
  ubicacion         String?
  estado            String             @default("Bueno")
  valorReposicion   Float              @default(0)
  fechaAdquisicion  String?
  descripcion       String?
  condominioId      String?
  centroCostoId     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  CentroCostoMaster CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  Condominio        Condominio?        @relation(fields: [condominioId], references: [id])
}

model CatMaterial {
  id                String             @id
  codigo            String?            @unique
  nombre            String
  unidad            String             @default("unidad")
  precioUnit        Float              @default(0)
  categoria         String             @default("General")
  stockMinimo       Int                @default(0)
  stockActual       Int                @default(0)
  ubicacion         String?
  descripcion       String?
  condominioId      String?
  centroCostoId     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  CentroCostoMaster CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  Condominio        Condominio?        @relation(fields: [condominioId], references: [id])
}

model CatTarea {
  id                String             @id
  codigo            String?            @unique
  nombre            String
  categoria         String             @default("General")
  sistema           String?
  tipoMantencion    String             @default("Preventivo")
  frecuencia        String?
  responsable       String?
  tiempoEstimado    Int                @default(0)
  descripcion       String?
  condominioId      String?
  centroCostoId     String?
  esRecurrente      Boolean            @default(false)
  activa            Boolean            @default(true)
  proximaEjecucion  String?
  ultimaEjecucion   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  CentroCostoMaster CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  Condominio        Condominio?        @relation(fields: [condominioId], references: [id])
}

model CentroCostoMaster {
  id               String           @id
  codigo           String           @unique
  nombre           String
  descripcion      String?
  responsable      String?
  tipoGasto        String           @default("Variable")
  presupuestoMens  Float            @default(0)
  presupuestoAnual Float            @default(0)
  estado           String           @default("Activo")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  condominioId     String?
  CatHerramienta   CatHerramienta[]
  CatMaterial      CatMaterial[]
  CatTarea         CatTarea[]
  Condominio       Condominio?      @relation(fields: [condominioId], references: [id])
  Gasto            Gasto[]
  OrdenTrabajo     OrdenTrabajo[]
}

model Condominio {
  id                String              @id
  nombre            String
  direccion         String?
  comuna            String?
  ciudad            String?
  rut               String?
  telefono          String?
  email             String?
  logo              String?
  etapas            String?
  estado            String              @default("Activo")
  fechaInicio       String?
  notas             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Activo            Activo[]
  CatHerramienta    CatHerramienta[]
  CatMaterial       CatMaterial[]
  CatTarea          CatTarea[]
  CentroCostoMaster CentroCostoMaster[]
  Gasto             Gasto[]
  GastoComun        GastoComun[]
  Inspeccion        Inspeccion[]
  Notificacion      Notificacion[]
  OrdenTrabajo      OrdenTrabajo[]
  Personal          Personal[]
  Propiedad         Propiedad[]
  Proveedor         Proveedor[]
  Proyecto          Proyecto[]
  PuntoRonda        PuntoRonda[]
  Reserva           Reserva[]
  Residente         Residente[]
}

model Configuracion {
  id          String   @id
  clave       String   @unique
  valor       String
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Cuenta {
  id           String    @id
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model CuentaContable {
  id                   String           @id
  codigo               String           @unique
  nombre               String
  tipo                 String           @default("Cuenta")
  nivel                Int              @default(1)
  padreId              String?
  saldo                Float            @default(0)
  estado               String           @default("Activa")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  CuentaContable       CuentaContable?  @relation("CuentaContableToCuentaContable", fields: [padreId], references: [id])
  other_CuentaContable CuentaContable[] @relation("CuentaContableToCuentaContable")
  DetalleAsiento       DetalleAsiento[]
}

model Cumplimiento {
  id                    String                  @id
  titulo                String
  categoria             String                  @default("Legal")
  subcategoria          String?
  descripcion           String?
  obligatorio           Boolean                 @default(true)
  fechaVencimiento      String?
  fechaRecordatorio     String?
  estado                String                  @default("Pendiente")
  documentoUrl          String?
  documentoNombre       String?
  notas                 String?
  cumplimientoPorc      Int                     @default(0)
  condominioId          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  HistorialCumplimiento HistorialCumplimiento[]
}

model DetalleAsiento {
  id              String          @id
  glosa           String?
  debe            Float           @default(0)
  haber           Float           @default(0)
  cuentaId        String
  asientoId       String
  createdAt       DateTime        @default(now())
  AsientoContable AsientoContable @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  CuentaContable  CuentaContable  @relation(fields: [cuentaId], references: [id])
}

model DetalleGastoComun {
  id           String     @id
  concepto     String
  categoria    String     @default("General")
  monto        Float      @default(0)
  centroCosto  String?
  notas        String?
  gastoComunId String
  GastoComun   GastoComun @relation(fields: [gastoComunId], references: [id], onDelete: Cascade)
}

model Gasto {
  id                String             @id
  descripcion       String
  categoria         String             @default("Mantenimiento")
  estado            String             @default("Pendiente")
  monto             Float              @default(0)
  fecha             String?
  propiedad         String?
  proveedorId       String?
  nDoc              String?
  notas             String?
  comprobante       String?
  condominioId      String?
  centroCostoId     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  CentroCostoMaster CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  Condominio        Condominio?        @relation(fields: [condominioId], references: [id])
  Proveedor         Proveedor?         @relation(fields: [proveedorId], references: [id])
}

model GastoComun {
  id                String              @id
  periodo           String
  fechaEmision      String
  fechaVencimiento  String
  estado            String              @default("Pendiente")
  totalGastos       Float               @default(0)
  totalCobrar       Float               @default(0)
  montoPorUnidad    Float               @default(0)
  notas             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  condominioId      String?
  DetalleGastoComun DetalleGastoComun[]
  Condominio        Condominio?         @relation(fields: [condominioId], references: [id])
  PagoGastoComun    PagoGastoComun[]
}

model HistorialAprobacionOT {
  id              String       @id
  otId            String
  estadoAnterior  String?
  estadoNuevo     String
  observaciones   String?
  aprobadoPor     String?
  nombreAprobador String?
  fechaAccion     String
  createdAt       DateTime     @default(now())
  OrdenTrabajo    OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model HistorialCumplimiento {
  id             String       @id
  cumplimientoId String
  accion         String
  descripcion    String
  usuarioId      String?
  usuarioNombre  String?
  fecha          String
  createdAt      DateTime     @default(now())
  Cumplimiento   Cumplimiento @relation(fields: [cumplimientoId], references: [id], onDelete: Cascade)
}

model Inspeccion {
  id           String      @id
  titulo       String
  tipo         String      @default("Mantenimiento")
  estado       String      @default("Planificado")
  fecha        String?
  hora         String?
  ubicacion    String?
  asignado     String?
  descripcion  String?
  recurrente   Boolean     @default(false)
  notas        String?
  fotosAntes   String?
  fotosDurante String?
  fotosDespues String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  condominioId String?
  Condominio   Condominio? @relation(fields: [condominioId], references: [id])
}

model LogAuditoria {
  id           String   @id
  userId       String?
  accion       String
  entidad      String
  entidadId    String?
  datosAntes   String?
  datosDespues String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  User         User?    @relation(fields: [userId], references: [id])
}

model Notificacion {
  id           String      @id
  titulo       String
  mensaje      String
  tipo         String      @default("Info")
  categoria    String      @default("General")
  destino      String      @default("Todos")
  destinoId    String?
  leido        Boolean     @default(false)
  fechaEnvio   String?
  fechaLeido   String?
  condominioId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  Condominio   Condominio? @relation(fields: [condominioId], references: [id])
}

model OTDocumento {
  id           String       @id
  nombre       String
  tipo         String       @default("documento")
  archivo      String
  otId         String
  OrdenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTHerramienta {
  id           String       @id
  nombre       String
  cantidad     Int          @default(1)
  otId         String
  OrdenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTMaterial {
  id           String       @id
  descripcion  String
  cantidad     Float        @default(1)
  precioUnit   Float        @default(0)
  total        Float        @default(0)
  unidad       String       @default("unidad")
  otId         String
  OrdenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTPersonal {
  id              String       @id
  nombre          String
  tipo            String       @default("Interno")
  cantidad        Int          @default(1)
  precioUnit      Float        @default(0)
  horasTrabajadas Float        @default(0)
  total           Float        @default(0)
  cumple          Boolean?
  observaciones   String?
  otId            String
  OrdenTrabajo    OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OTTarea {
  id           String       @id
  descripcion  String
  cantidad     Int          @default(1)
  estado       String       @default("Pendiente")
  otId         String
  OrdenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
}

model OrdenTrabajo {
  id                    String                  @id
  otNum                 String                  @unique
  titulo                String
  tipo                  String                  @default("Correctivo")
  prioridad             String                  @default("Media")
  estado                String                  @default("Pendiente")
  ubicacion             String?
  fechaInicio           String?
  fechaLimite           String?
  fechaInicioReal       String?
  fechaFinReal          String?
  costoEstimado         Float                   @default(0)
  costoReal             Float                   @default(0)
  progreso              Int                     @default(0)
  descripcion           String?
  tiempoEst             Int                     @default(0)
  tiempoReal            Int                     @default(0)
  valorHora             Float                   @default(0)
  notas                 String?
  esRecurrente          Boolean                 @default(false)
  tareaOrigenId         String?
  proximaEjecucion      String?
  formaPago             String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  condominioId          String?
  propiedadId           String?
  asignadoId            String?
  activoId              String?
  centroCostoId         String?
  aprobadoPor           String?
  estadoAprobacion      String?                 @default("Pendiente")
  fechaAprobacion       String?
  fechaSolicitudAprob   String?
  observacionesAprob    String?
  HistorialAprobacionOT HistorialAprobacionOT[]
  OTDocumento           OTDocumento[]
  OTHerramienta         OTHerramienta[]
  OTMaterial            OTMaterial[]
  OTPersonal            OTPersonal[]
  OTTarea               OTTarea[]
  CentroCostoMaster     CentroCostoMaster?      @relation(fields: [centroCostoId], references: [id])
  Activo                Activo?                 @relation(fields: [activoId], references: [id])
  Personal              Personal?               @relation(fields: [asignadoId], references: [id])
  Propiedad             Propiedad?              @relation(fields: [propiedadId], references: [id])
  Condominio            Condominio?             @relation(fields: [condominioId], references: [id])
}

model PagoGastoComun {
  id           String     @id
  monto        Float      @default(0)
  fechaPago    String
  metodo       String     @default("Efectivo")
  referencia   String?
  estado       String     @default("Pagado")
  notas        String?
  residenteId  String?
  gastoComunId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  GastoComun   GastoComun @relation(fields: [gastoComunId], references: [id])
  Residente    Residente? @relation(fields: [residenteId], references: [id])
}

model Personal {
  id           String         @id
  nombre       String
  rut          String?
  cargo        String?
  contrato     String         @default("Indefinido")
  afp          String         @default("ProVida")
  salud        String         @default("Fonasa")
  mutual       String         @default("IST")
  ccaf         String?
  fechaIngreso String?
  sueldoBase   Float          @default(0)
  movilizacion Float          @default(0)
  colacion     Float          @default(0)
  viatico      Float          @default(0)
  asigFamiliar Float          @default(0)
  estado       String         @default("Activo")
  email        String?
  telefono     String?
  notas        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  condominioId String?
  Activo       Activo[]
  Asistencia   Asistencia[]
  OrdenTrabajo OrdenTrabajo[]
  Condominio   Condominio?    @relation(fields: [condominioId], references: [id])
}

model Propiedad {
  id           String         @id
  nombre       String
  tipo         String         @default("Casa")
  estado       String         @default("Disponible")
  direccion    String?
  habitaciones Int            @default(0)
  banos        Int            @default(0)
  mts2         Float          @default(0)
  precio       Float          @default(0)
  contacto     String?
  telefono     String?
  email        String?
  fotos        String?
  notas        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  condominioId String?
  OrdenTrabajo OrdenTrabajo[]
  Condominio   Condominio?    @relation(fields: [condominioId], references: [id])
  Residente    Residente[]
}

model Proveedor {
  id            String      @id
  razonSocial   String
  rut           String?
  giro          String?
  direccion     String?
  comuna        String?
  telCorp       String?
  emailCorp     String?
  web           String?
  contacto      String?
  cargo         String?
  telDirecto    String?
  emailContacto String?
  celular       String?
  estado        String      @default("Activo")
  notas         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  condominioId  String?
  Gasto         Gasto[]
  Condominio    Condominio? @relation(fields: [condominioId], references: [id])
}

model Proyecto {
  id                  String                @id
  nombre              String
  categoria           String                @default("General")
  estado              String                @default("Planificado")
  ubicacion           String?
  fechaInicio         String?
  fechaFin            String?
  presProg            Float                 @default(0)
  presUsado           Float                 @default(0)
  avance              Int                   @default(0)
  descripcion         String?
  notas               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  condominioId        String?
  Condominio          Condominio?           @relation(fields: [condominioId], references: [id])
  ProyectoHerramienta ProyectoHerramienta[]
  ProyectoMaterial    ProyectoMaterial[]
  ProyectoPersonal    ProyectoPersonal[]
  ProyectoTarea       ProyectoTarea[]
}

model ProyectoHerramienta {
  id         String   @id
  nombre     String
  cantidad   Int      @default(1)
  proyectoId String
  Proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoMaterial {
  id          String   @id
  descripcion String
  cantidad    Float    @default(1)
  precioUnit  Float    @default(0)
  total       Float    @default(0)
  unidad      String   @default("unidad")
  proyectoId  String
  Proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoPersonal {
  id         String   @id
  nombre     String
  tipo       String   @default("Interno")
  cantidad   Int      @default(1)
  precioUnit Float    @default(0)
  total      Float    @default(0)
  proyectoId String
  Proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model ProyectoTarea {
  id          String   @id
  descripcion String
  cantidad    Int      @default(1)
  estado      String   @default("Pendiente")
  proyectoId  String
  Proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model PuntoRonda {
  id            String          @id
  nombre        String
  ubicacion     String
  descripcion   String?
  codigoQr      String          @unique
  activo        Boolean         @default(true)
  orden         Int             @default(0)
  condominioId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Condominio    Condominio?     @relation(fields: [condominioId], references: [id])
  RegistroRonda RegistroRonda[]
}

model RegistroRonda {
  id             String     @id
  puntoId        String
  usuarioId      String?
  usuarioNombre  String?
  fechaHora      DateTime   @default(now())
  ubicacion      String?
  observaciones  String?
  foto           String?
  estado         String     @default("Normal")
  notaIncidencia String?
  createdAt      DateTime   @default(now())
  PuntoRonda     PuntoRonda @relation(fields: [puntoId], references: [id])

  @@index([usuarioId])
  @@index([puntoId, fechaHora])
}

model Reserva {
  id           String      @id
  titulo       String
  espacio      String
  fecha        String
  horaInicio   String
  horaFin      String
  residente    String
  unidad       String?
  telefono     String?
  email        String?
  numPersonas  Int         @default(1)
  estado       String      @default("Pendiente")
  monto        Float       @default(0)
  pagado       Boolean     @default(false)
  notas        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  condominioId String?
  residenteId  String?
  Residente    Residente?  @relation(fields: [residenteId], references: [id])
  Condominio   Condominio? @relation(fields: [condominioId], references: [id])
}

model Residente {
  id             String           @id
  nombre         String
  apellido       String?
  rut            String?
  unidad         String?
  etapa          String?
  tipo           String           @default("Residente")
  telefono       String?
  email          String?
  fechaIngreso   String?
  estado         String           @default("Activo")
  vehiculos      String?
  notas          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  condominioId   String?
  propiedadId    String?
  PagoGastoComun PagoGastoComun[]
  Reserva        Reserva[]
  Propiedad      Propiedad?       @relation(fields: [propiedadId], references: [id])
  Condominio     Condominio?      @relation(fields: [condominioId], references: [id])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String         @id
  email            String         @unique
  nombre           String
  apellido         String?
  password         String
  rut              String?        @unique
  telefono         String?
  direccion        String?
  rol              String         @default("usuario")
  permisos         String?
  activo           Boolean        @default(true)
  emailVerificado  DateTime?
  ultimoAcceso     DateTime?
  intentosLogin    Int            @default(0)
  bloqueadoHasta   DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean        @default(false)
  resetToken       String?
  resetTokenExp    DateTime?
  creadoPor        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  Cuenta           Cuenta[]
  LogAuditoria     LogAuditoria[]
  Session          Session[]
}
