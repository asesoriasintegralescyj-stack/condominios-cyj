// Categorías de documentos de cumplimiento (basado en Ley 21.442)
model CategoriaCumplimiento {
  id              String   @id @default(cuid())
  nombre          String   // Nombre de la categoría
  codigo          String?  @unique // Código identificador (LEY-001, SEG-001, etc.)
  descripcion     String?  // Descripción de la categoría
  tipo            String   @default("Legal") // Legal, Reglamentario, Interno, Seguridad
  obligatorio     Boolean  @default(true) // Si es obligatorio por ley
  orden           Int      @default(0) // Orden de visualización
  activo          Boolean  @default(true)
  
  // Referencia legal
  articuloLey     String?  // Artículo de la ley que lo exige (ej: "Art. 8 Ley 21.442")
  fechaLimiteDias Int?     // Días límite para renovación/vencimiento
  
  // Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])
  
  // Documentos en esta categoría
  documentos      DocumentoCumplimiento[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([condominioId, tipo])
}

// Documentos de cumplimiento
model DocumentoCumplimiento {
  id              String   @id @default(cuid())
  titulo          String   // Título del documento
  descripcion     String?  // Descripción o notas
  
  // Archivo adjunto
  archivoNombre   String?  // Nombre original del archivo
  archivoTipo     String?  // Tipo MIME del archivo
  archivoBase64   String?  // Archivo en base64
  archivoUrl      String?  // URL del archivo si está almacenado externamente
  
  // Fechas importantes
  fechaDocumento  String?  // Fecha del documento
  fechaVencimiento String? // Fecha de vencimiento si aplica
  fechaAprobacion String?  // Fecha de aprobación si aplica
  
  // Estado del documento
  estado          String   @default("Pendiente") // Pendiente, Aprobado, Rechazado, Vencido, En Revisión
  cumple          Boolean  @default(false) // Si cumple con el requisito
  
  // Verificación
  verificadoPor   String?  // Nombre de quien verificó
  fechaVerificacion DateTime?
  observaciones   String?  // Observaciones de la verificación
  
  // Porcentaje de cumplimiento (calculado automáticamente)
  porcentajeCumplimiento Float @default(0) // 0-100%
  
  // Categoría
  categoriaId     String?
  categoria       CategoriaCumplimiento? @relation(fields: [categoriaId], references: [id])
  
  // Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])
  
  // Usuario que creó/editó
  creadoPor       String?  // ID del usuario
  creadoPorNombre String?  // Nombre del usuario
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([condominioId, estado])
  @@index([categoriaId])
  @@index([fechaVencimiento])
  @@index([estado])
}

// Historial de cambios en documentos de cumplimiento
model HistorialCumplimiento {
  id              String   @id @default(cuid())
  documentoId     String
  accion          String   // Creación, Actualización, Aprobación, Rechazo, Vencimiento
  descripcion     String   // Descripción del cambio
  estadoAnterior  String?  // Estado anterior
  estadoNuevo     String?  // Nuevo estado
  usuarioId       String?  // ID del usuario
  usuarioNombre   String?  // Nombre del usuario
  
  createdAt       DateTime @default(now())
  
  @@index([documentoId, createdAt])
}

// Resumen de cumplimiento por condominio
model ResumenCumplimiento {
  id                      String   @id @default(cuid())
  condominioId            String   @unique
  condominio              Condominio @relation(fields: [condominioId], references: [id])
  
  // Contadores
  totalRequisitos         Int      @default(0)
  requisitosCumplidos     Int      @default(0)
  requisitosPendientes    Int      @default(0)
  requisitosVencidos      Int      @default(0)
  
  // Porcentaje general
  porcentajeGeneral       Float    @default(0)
  
  // Porcentajes por categoría
  porcentajeLegal         Float    @default(0)
  porcentajeReglamentario Float    @default(0)
  porcentajeInterno       Float    @default(0)
  porcentajeSeguridad     Float    @default(0)
  
  // Última actualización
  ultimaActualizacion     DateTime @default(now())
  
  // Alertas
  alertasActivas          Int      @default(0)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ============================================
// RONDAS Y CONTROL DE RONDAS (QR)
// ============================================
model Ronda {
  id              String   @id @default(cuid())
  nombre          String   // Nombre de la ronda
  codigo          String   @unique // Código único para QR
  ubicacion       String   // Ubicación de la ronda
  descripcion     String?
  activo          Boolean  @default(true)
  qrCodigo        String?  // URL del QR: https://condominios-cyj.vercel.app/ronda/{ETAPA}/{POST}
  
  // Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])
  
  // Usuario que creó
  creadoPor       String?
  creadoPorNombre String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  registros       RegistroRonda[]
  
  @@index([condominioId, activo])
  @@index([codigo])
}

model RegistroRonda {
  id              String   @id @default(cuid())
  rondaId         String
  ronda           Ronda    @relation(fields: [rondaId], references: [id])
  
  // Usuario que escaneó
  usuarioId       String?
  usuarioNombre   String?
  
  // Datos del registro
  fecha           String   // Fecha del registro
  hora            String   // Hora del registro
  ubicacion       String?  // Ubicación al momento del escaneo
  observaciones   String?
  
  // Coordenadas (opcional)
  latitud         Float?
  longitud        Float?
  
  createdAt       DateTime @default(now())
  
  @@index([rondaId, fecha])
  @@index([usuarioId, fecha])
}

// ============================================
// SOLICITUDES DE COMPRA
// ============================================
model SolicitudCompra {
  id              String   @id @default(cuid())
  codigo          String   @unique // SC-0001, SC-0002, etc.
  titulo          String
  descripcion     String?
  estado          String   @default("Solicitado") // Solicitado, En Proceso, Comprado, Rechazado, Anulada
  prioridad       String   @default("Media") // Baja, Media, Alta, Urgente
  origenTipo      String?  // OT, Manual
  origenId        String?  // ID de la OT si vino de ahí
  origenCodigo    String?  // OT-0001 etc
  materiales      String?  // JSON array con [{nombre, cantidad, unidad, precioEstimado, total}]
  totalEstimado   Float    @default(0)
  solicitadoPor   String?  // Nombre del usuario
  solicitadoPorId String?  // ID del usuario
  fechaSolicitud  DateTime @default(now())
  fechaEspera     String?  // Fecha esperada de entrega
  proveedorSugerido String?
  observaciones   String?
  // Links de compra (JSON array de URLs)
  links           String?
  // Email
  emailEnviado    Boolean  @default(false)
  emailEnviadoA   String?  // administracionlagunanorte@gmail.com
  emailFechaEnvio DateTime?
  // Condominio
  condominioId    String?
  condominio      Condominio? @relation(fields: [condominioId], references: [id])

  // ===== Campos del flujo de aprobación =====
  // Etapa del flujo: 'Pendiente Supervisor' → 'Aprobada Supervisor' → 'Aprobada Admin' (lista para gestionar)
  //                                              ↘ 'Rechazada Supervisor'
  //                                                  ↘ 'Rechazada Admin'
  etapaAprobacion String   @default("Pendiente Supervisor") // Pendiente Supervisor, Aprobada Supervisor, Aprobada Admin, Rechazada Supervisor, Rechazada Admin
  // Supervisor
  supervisorAprobadorId   String?
  supervisorAprobadorNombre String?
  supervisorFechaAprobacion DateTime?
  supervisorObservaciones String?
  // Admin (gestión final)
  adminAprobadorId        String?
  adminAprobadorNombre    String?
  adminFechaAprobacion    DateTime?
  adminObservaciones      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  historialAprobaciones HistorialAprobacionSC[]

  @@index([estado, createdAt])
  @@index([condominioId])
  @@index([origenTipo, origenId])
  @@index([etapaAprobacion])
}

// ============================================
// HISTORIAL DE APROBACIONES DE SOLICITUDES DE COMPRA
// ============================================
model HistorialAprobacionSC {
  id              String   @id @default(cuid())
  solicitudId     String
  solicitud       SolicitudCompra @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  etapaAnterior   String?
  etapaNueva      String
  accion          String   // aprobar_supervisor, rechazar_supervisor, aprobar_admin, rechazar_admin
  observaciones   String?
  aprobadorId     String?
  aprobadorNombre String?
  fechaAccion     DateTime @default(now())

  @@index([solicitudId, fechaAccion])
}

// Listas desplegables configurables
model ListaDesplegable {
  id           String   @id @default(cuid())
  nombre       String
  tipo         String
  valor        String
  activo       Boolean  @default(true)
  condominioId String?
  condominio   Condominio? @relation(fields: [condominioId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tipo, activo])
}

// ============================================
// PMI — PLAN DE MANTENIMIENTO INTEGRAL
// Listas de Verificación (LV-01 a LV-20) y sus registros de ejecución
// ============================================
model ListaVerificacion {
  id                String   @id @default(cuid())
  codigo            String   @unique // LV-01, LV-02, etc.
  nombre            String
  sector            String
  frecuencia        String   // Diaria, Semanal, Quincenal, Mensual, Trimestral, Semestral, Anual
  responsable       String
  personalRequerido String?
  descripcion       String?
  items             String   @default("[]") // JSON array de {seccion, titulo, items: string[]}
  activa            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  registros RegistroLV[]

  @@index([frecuencia])
  @@index([activa])
}

model RegistroLV {
  id                   String   @id @default(cuid())
  lvId                 String
  lv                   ListaVerificacion @relation(fields: [lvId], references: [id], onDelete: Cascade)
  fecha                String   // YYYY-MM-DD
  hora                 String?
  responsableEjecucion String?
  estado               String   @default("Pendiente") // Pendiente, En Progreso, Completado
  observaciones        String?
  itemsCompletados     String?  // JSON array de índices de items completados
  firmaUrl             String?
  fotoUrl              String?
  pdfRespaldoUrl       String?
  pdfRespaldoNombre    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lvId, fecha])
  @@index([fecha])
}

// ============================================
// SECUENCIAS — Correlativos automáticos
// ============================================
model Secuencia {
  id        String   @id @default(cuid())
  tabla     String   @unique // "OrdenTrabajo", "Proyecto", "SolicitudCompra", etc.
  prefijo   String   // "OT", "PROY", "SC", "HERR", "MAT", "TAR", "ACT"
  ultimoNum Int      @default(0)
  padding   Int      @default(3)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// MODELOS DE LA APP MÓVIL
// ============================================

model MovilProfile {
  id          String   @id @default(cuid())
  name        String
  password    String   @default("")
  accessCode  String   @default("")
  color       String   @default("")
  icon        String   @default("")
  workAreaIds String[] @default([])
  permissions String[] @default(["view"])
  personalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([accessCode])
}

model MovilQrLocation {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  location    String   @default("")
  code        String   @unique
  active      Boolean  @default(true)
  createdBy   String   @default("admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([active])
}

model MovilQrScan {
  id           String    @id @default(cuid())
  qrLocationId String
  scannedBy    String    @default("")
  profileId    String?
  latitude     Float?
  longitude    Float?
  notes        String    @default("")
  createdAt    DateTime  @default(now())

  @@index([qrLocationId])
  @@index([scannedBy])
  @@index([createdAt])
}

model MovilPatente {
  id            String    @id @default(cuid())
  patente       String
  ubicacion     String
  entradaQrCode String?
  entradaScanId String?
  entradaAt     DateTime  @default(now())
  salidaQrCode  String?
  salidaScanId  String?
  salidaAt      DateTime?
  scannedBy     String    @default("")
  profileId     String?
  latitude      Float?
  longitude     Float?
  foto          String?
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ubicacion, salidaAt])
  @@index([patente])
  @@index([entradaAt])
  @@index([scannedBy])
}

model MovilAuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  entityName  String   @default("")
  changes     String   @default("{}")
  performedBy String   @default("admin")
  profileId   String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// RENDICIÓN DE GASTOS
// ============================================
model CategoriaGasto {
  id     String  @id @default(cuid())
  nombre String  @unique
  icon   String  @default("📌")
  activo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ItemRendicion[]
}

model RendicionGasto {
  id              String   @id @default(cuid())
  numeroRendicion String   @unique              // RG-0001, RG-0002, ...
  titulo          String
  descripcion     String?
  estado          String   @default("BORRADOR") // BORRADOR, ENVIADO, APROBADO, RECHAZADO, MODIFICACION
  montoTotal      Float    @default(0)
  userId          String
  condominioId    String?
  centroCostoId   String?
  notaRevision    String?
  revisadoPor     String?
  revisadoAt      DateTime?
  enviadoAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
  condominio Condominio? @relation(fields: [condominioId], references: [id])
  centroCosto CentroCostoMaster? @relation(fields: [centroCostoId], references: [id])
  items      ItemRendicion[]

  @@index([userId])
  @@index([condominioId])
  @@index([centroCostoId])
  @@index([estado])
  @@index([createdAt])
}

model ItemRendicion {
  id              String   @id @default(cuid())
  descripcion     String
  numeroBoleta    String?
  montoRendir     Float
  categoria       String?
  fechaGasto      String?
  fotoBoletaUrl   String?  // base64 JPEG
  fotoCompraUrl   String?  // base64 JPEG
  rendicionId     String
  categoriaGastoId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rendicion     RendicionGasto @relation(fields: [rendicionId], references: [id], onDelete: Cascade)
  categoriaGasto CategoriaGasto? @relation(fields: [categoriaGastoId], references: [id])

  @@index([rendicionId])
  @@index([categoriaGastoId])
}
