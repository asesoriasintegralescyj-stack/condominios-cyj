// CONFIGURACIÓN DEL SISTEMA
// ============================================
model Configuracion {
  id            String   @id @default(cuid())
  clave         String   @unique
  valor         String
  descripcion   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
